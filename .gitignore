User/
agent-host/
languagepacks.json
logs/
machineid
.vscode/

# ── Ansible ────────────────────────────────────────────────────────────────
# Generated at run time and SECRET: admin.conf holds cluster-admin client
# certs, join-commands.sh holds live bootstrap tokens and CA hashes.
artifacts/
*.retry
*.log

# ansible-navigator: playbook artifacts replay every task's output — join
# tokens, certificate keys, kubectl output — so they are as secret as artifacts/.
navigator-artifacts/

# ── Local tooling ──────────────────────────────────────────────────────────
.claude/settings.local.json
.venv/
__pycache__/
*.pyc

# ── Editor / OS noise ──────────────────────────────────────────────────────
*.swp
*~
.DS_Store
